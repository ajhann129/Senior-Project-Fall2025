<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <% if (!groupChat) {%>
            <title>Apollo Chat with <%=friendName%></title>
    <%} else {%>
            <title>Apollo Chat in <%=groupName%></title>
    <%}%>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <div class="titleHeader">
        <h1><a href="index.html">Apollo</a></h1>
    </div>

    <div class="interface">
        
        <!--If the chat interface is not for a group, display related HTML-->
        <% if (!groupChat) {%>
            <!--forEach loop to display direct messages-->
            <h1 id="dmHeader">Chat between <%=userVal%> and <span id="friendName"><%=friendName%></span></h1>
            <% if (directMsg) {%>
                <%directMsg.forEach(function(message) {%>
                    <p class="displayedMsg"><span class="msgData"><%=message.Date_sent.toLocaleString()%> UTC, <%=message.Username%></span><span class="textContent"><%=message.Content%></span></p>
                <%});%>
            <%}%>

        <!--Otherwise, display related HTML for a group chat-->
        <%} else {%>
            <h1 id="groupHeader">Chat in <span id="groupName"><%=groupName%></span></h1>
            <!--forEach loop to display group messages-->
            <% if (groupMsg) {%>
                <%groupMsg.forEach(function(message) {%>
                    <p class="displayedMsg"><span class="msgData"><%=message.Date_sent.toLocaleString()%> UTC, <%=message.Username%></span><span class="textContent"><%=message.Content%></span></p>
                <%});%>
            <%}%>
        <%}%>

        <form method="POST">
            <textarea maxlength="300" id="usrMsg"></textarea>
            <button type="submit" id="sendMsg">Send</button>
        </form>
    </div>

    <script>

        const usrMsg = document.getElementById('usrMsg');
        const sendMsg = document.getElementById('sendMsg');

        const friendName = document.getElementById('friendName');
        const groupName = document.getElementById('groupName')

        const userVal = '<%-userVal%>';
        const groupChat = '<%-groupChat%>';

        // Interval to periodically refresh page every 30 seconds
        setInterval(() => {
            location.reload();
        }, 20000);

        // Event listener to autoscroll page to latest message
        document.addEventListener('DOMContentLoaded', function() {
            window.scrollTo(0, document.body.scrollHeight);
        });

        // Event listener for send button
        sendMsg.addEventListener('click', (event) => {

            // If usrMsg's value is not blank excluding whitespace, then send and display the message
            if (usrMsg.value.trim() != '') {
                
                event.preventDefault();

                if (friendName) {

                    // Create a new Date object and convert it to a string, then assign it to variable
                    msgDate = new Date();

                    const data = {userVal: userVal, friendName: friendName.innerHTML, usrMsg: usrMsg.value, msgDate: msgDate};
                    
                    text = usrMsg.value;
                    usrMsg.value = '';

                    fetch('http://localhost:3000/chat', {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        // Convert the object data to a string format
                        body: JSON.stringify(data)
                    });

                    location.reload();

                }

                else if (groupName) {

                    // Create a new Date object and convert it to a string, then assign it to variable
                    msgDate = new Date();

                    const data = {userVal: userVal, groupName: groupName.innerHTML, usrMsg: usrMsg.value, msgDate: msgDate};
                    
                    text = usrMsg.value;
                    usrMsg.value = '';

                    fetch('http://localhost:3000/chat', {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        // Convert the object data to a string format
                        body: JSON.stringify(data)
                    });

                    location.reload();

                }

            }

        });

        // Event listener to send message with the Enter key
        usrMsg.addEventListener('keydown', (event) => {
            
            // If usrMsg's value is not blank excluding whitespace, and user presses the Enter key, then send and display the message
            if (event.key == 'Enter' && usrMsg.value.trim() != '') {
                
                event.preventDefault();

                if (friendName) {

                    // Create a new Date object and convert it to a string, then assign it to variable
                    msgDate = new Date();

                    const data = {userVal: userVal, friendName: friendName.innerHTML, usrMsg: usrMsg.value, msgDate: msgDate};
                    
                    text = usrMsg.value;
                    usrMsg.value = '';

                    fetch('http://localhost:3000/chat', {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        // Convert the object data to a string format
                        body: JSON.stringify(data)
                    });

                    location.reload();

                }

                else if (groupName) {

                    // Create a new Date object and convert it to a string, then assign it to variable
                    msgDate = new Date();

                    const data = {userVal: userVal, groupName: groupName.innerHTML, usrMsg: usrMsg.value, msgDate: msgDate};
                    
                    text = usrMsg.value;
                    usrMsg.value = '';

                    fetch('http://localhost:3000/chat', {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        // Convert the object data to a string format
                        body: JSON.stringify(data)
                    });

                    location.reload();

                }
                
            }
            
        });

    </script>
</body>
</html>