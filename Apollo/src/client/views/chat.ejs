<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <% if (!groupChat) {%>
            <title>Apollo Chat with <%=friendName%></title>
    <%} else {%>
            <title>Apollo Chat in <%=groupName%></title>
    <%}%>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <div class="titleHeader">
        <h1><a href="index.html">Apollo</a></h1>
    </div>

    <div class="interface">
        
        <!--If the chat interface is not for a group, display related HTML-->
        <% if (!groupChat) {%>
            <!--forEach loop to display direct messages-->
            <h1 id="dmHeader">Chat between <%=userVal%> and <span id="friendName"><%=friendName%></span></h1>
            <% if (directMsg) {%>
                <%directMsg.forEach(function(message) {%>
                    <p class="displayedMsg"><span class="msgData"><%=message.Date_sent.toLocaleString()%> <%=message.Username%></span><span class="textContent"><%=message.Content%></span></p>
                <%});%>
            <%}%>

        <!--Otherwise, display related HTML for a group chat-->
        <%} else {%>
            <h1 id="groupHeader">Chat in <span id="groupName"><%=groupName%></span></h1>
            <!--forEach loop to display group messages-->
            <% if (groupMsg) {%>
                <%groupMsg.forEach(function(message) {%>
                    <p class="displayedMsg"><span class="msgData"><%=message.Date_sent.toLocaleString()%> <%=message.Username%></span><span class="textContent"><%=message.Content%></span></p>
                <%});%>
            <%}%>
        <%}%>

        <form method="POST">
            <textarea maxlength="300" id="usrMsg"></textarea>
            <button type="submit" id="sendMsg">Send</button>
        </form>
    </div>

    <script>

        const usrMsg = document.getElementById('usrMsg');
        const sendMsg = document.getElementById('sendMsg');

        const friendName = document.getElementById('friendName');
        const groupName = document.getElementById('groupName')

        const userVal = '<%-userVal%>';
        const groupChat = '<%-groupChat%>';
        
        // Function to display a message on the webpage
        function displayMsg(msgDate, text) {

            // If usrMsg's value is not blank excluding whitespace, then send and display the message
            if (text.trim() != '') {

                // Create a new p element and assign it a class of displayedMsg
                message = document.createElement('p');
                message.setAttribute('class', 'displayedMsg');

                // Create a new span element and assign a string including currDate and userVal to its innerHTML 
                msgData = document.createElement('span');
                msgData.innerHTML = msgDate.toLocaleString() + ' ' + userVal;

                // Assign the first span element a class of msgData
                msgData.setAttribute('class', 'msgData');

                // Create a new span element and assign the value of text to its innerHTML
                textContent = document.createElement('span');
                textContent.innerHTML = text;

                // Assign the second span element a class of textContent
                textContent.setAttribute('class', 'textContent');

                // Append msgData as a child of message
                message.appendChild(msgData);

                // Add textContent as an additional child within message
                msgData.after(textContent);

                // Insert the created p element message above the usrMsg input element, then clear usrMsg's value
                usrMsg.before(message);
                usrMsg.value = '';
            }

        }

        // Event listener for send button
        sendMsg.addEventListener('click', (event) => {

            // If usrMsg's value is not blank excluding whitespace, then send and display the message
            if (usrMsg.value.trim() != '') {
                
                event.preventDefault();

                if (friendName) {

                    // Create a new Date object and convert it to a string, then assign it to variable
                    msgDate = new Date();

                    const data = {userVal: userVal, friendName: friendName.innerHTML, usrMsg: usrMsg.value, msgDate: msgDate};
                    
                    text = usrMsg.value;
                    usrMsg.value = '';

                    fetch('http://localhost:3000/chat', {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        // Convert the object data to a string format
                        body: JSON.stringify(data)
                    });

                    displayMsg(msgDate, text);

                }

                else if (groupName) {

                    // Create a new Date object and convert it to a string, then assign it to variable
                    msgDate = new Date();

                    const data = {userVal: userVal, groupName: groupName.innerHTML, usrMsg: usrMsg.value, msgDate: msgDate};
                    
                    text = usrMsg.value;
                    usrMsg.value = '';

                    fetch('http://localhost:3000/chat', {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        // Convert the object data to a string format
                        body: JSON.stringify(data)
                    });

                    displayMsg(msgDate, text);

                }

            }

        });

        // Event listener to send message with the Enter key
        usrMsg.addEventListener('keydown', (event) => {
            
            // If usrMsg's value is not blank excluding whitespace, and user presses the Enter key, then send and display the message
            if (event.key == 'Enter' && usrMsg.value.trim() != '') {
                
                event.preventDefault();

                if (friendName) {

                    // Create a new Date object and convert it to a string, then assign it to variable
                    msgDate = new Date();

                    const data = {userVal: userVal, friendName: friendName.innerHTML, usrMsg: usrMsg.value, msgDate: msgDate};
                    
                    text = usrMsg.value;
                    usrMsg.value = '';

                    fetch('http://localhost:3000/chat', {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        // Convert the object data to a string format
                        body: JSON.stringify(data)
                    });

                    displayMsg(msgDate, text);

                }

                else if (groupName) {

                    // Create a new Date object and convert it to a string, then assign it to variable
                    msgDate = new Date();

                    const data = {userVal: userVal, groupName: groupName.innerHTML, usrMsg: usrMsg.value, msgDate: msgDate};
                    
                    text = usrMsg.value;
                    usrMsg.value = '';

                    fetch('http://localhost:3000/chat', {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        // Convert the object data to a string format
                        body: JSON.stringify(data)
                    });

                    displayMsg(msgDate, text);

                }
                
            }
            
        });

    </script>
</body>
</html>